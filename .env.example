# dev | prod. В prod приложение не стартует с дефолтным SECRET_KEY, DEBUG_OTP или DEV_FIXED_OTP.
ENVIRONMENT=dev

# SQLite для разработки, PostgreSQL для продакшена:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/taxi
DATABASE_URL=sqlite:///./taxi.db

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=9BxurAJWZP7puOZGmJ5chP6ixkGXBGz72QeJJfRO6ie

# Только для разработки: возвращать OTP-код в ответе и/или всегда использовать один код
DEBUG_OTP=true
# DEV_FIXED_OTP=123456

# Телефоны админов через запятую (получают роль admin при входе по OTP)
ADMIN_PHONES=+77051299281

UPLOAD_DIR=uploads
CURRENCY=KZT
PLATFORM_COMMISSION_PERCENT=5
DRIVER_SEARCH_RADIUS_KM=15
